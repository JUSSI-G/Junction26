{
 "page_id": 900001918,
 "title": "Suomen sisällissota (demo)",
 "rev_id": 900001918053,
 "timestamp": "2017-08-01T03:30:24Z",
 "editor": "Neutraali",
 "anonymous": false,
 "comment": "pieniä korjauksia",
 "sentences": [
  {
   "hash": "dc2296f1693c52a0c8b92d1321de633c291ec11a021456ae0750b38c400e3130",
   "text": "Suomen sisällissota käytiin senaatin ja kansanvaltuuskunnan joukkojen välillä 27. tammikuuta – 15. toukokuuta 1918.",
   "position": 0,
   "since": "2013-12-29T23:48:24Z",
   "editor": "Historioitsija",
   "rev_id": 900001918047
  },
  {
   "hash": "11661965516104ba89267f46eb9ad0749ce405e50c1e50a3ce6ff94bdd31c1ad",
   "text": "Sodalle on annettu erilaisia nimiä, kuten vapaussota, punakapina, luokkasota ja kansalaissota, jotka heijastelevat eri osapuolten näkemyksiä.",
   "position": 1,
   "since": "2007-04-04T14:00:24Z",
   "editor": "Neutraali",
   "rev_id": 900001918035
  },
  {
   "hash": "3f22be0cc886f049beb0174989789c3c2ea10cdfe3c3596647ea068d5dce815d",
   "text": "Valkoisten joukkoja johti kenraali C. G. E. Mannerheim.",
   "position": 2,
   "since": "2004-03-14T12:00:00Z",
   "editor": "Kalervo",
   "rev_id": 900001918001
  },
  {
   "hash": "7d230f85e42126ae2c776f8955f05d0dd7dff704b8da533d4d3948efe9fd64a2",
   "text": "Ratkaiseva taistelu käytiin Tampereella maalis–huhtikuussa 1918.",
   "position": 3,
   "since": "2004-03-14T12:00:00Z",
   "editor": "Kalervo",
   "rev_id": 900001918001
  },
  {
   "hash": "5f59673225c0906f28d6a6d01f566c8f5670bb685b1c6e6b5282de716f450446",
   "text": "Saksan keisarikunnan joukot nousivat maihin Hankoon huhtikuussa 1918.",
   "position": 4,
   "since": "2004-03-14T12:00:00Z",
   "editor": "Kalervo",
   "rev_id": 900001918001
  },
  {
   "hash": "0a3a3ee00f9f7b483667e7d31276b4e01f6052a74d7a55ac85bb1b43c478fa77",
   "text": "Sodassa kuoli noin 38 000 ihmistä.",
   "position": 5,
   "since": "2006-07-24T10:55:24Z",
   "editor": "Tutkija88",
   "rev_id": 900001918030
  },
  {
   "hash": "8fd6756f8e3caf5a6f1315ba0b6ddd64c9154587c48e2e48832ce309cfc4296b",
   "text": "Punainen terrori kohdistui erityisesti maanomistajiin ja virkamiehiin.",
   "position": 6,
   "since": "2004-04-23T12:37:00Z",
   "editor": "Aino_K",
   "rev_id": 900001918002
  },
  {
   "hash": "799534671a0faf15ccff134ff80ab0c06a5a13b78cf57bb5ca1db66b33ffeb30",
   "text": "Punaisten joukot koostuivat pääosin punakaarteista.",
   "position": 7,
   "since": "2007-09-10T18:15:24Z",
   "editor": "Siivooja",
   "rev_id": 900001918038
  },
  {
   "hash": "6431af27286c515fccf76523ec5cc0f47e4e1110070ab3d19f9c7e87e2db9617",
   "text": "Valkoinen terrori ja vankileirit vaativat enemmän uhreja kuin itse taistelut.",
   "position": 8,
   "since": "2006-09-07T11:32:24Z",
   "editor": "Historioitsija",
   "rev_id": 900001918031
  },
  {
   "hash": "b99a6214750988d83cb47bd47aa6909ffa29059a9000e144ac221a336f2555f4",
   "text": "Sodan jälkeen noin 80 000 punaista vangittiin vankileireille.",
   "position": 9,
   "since": "2006-09-16T13:23:24Z",
   "editor": "Historioitsija",
   "rev_id": 900001918034
  },
  {
   "hash": "88778c9d55805de9432d59fe736c7f221d253d6916f73ec479f7fcf49175225d",
   "text": "Sota jätti syvät jäljet suomalaiseen yhteiskuntaan vuosikymmeniksi.",
   "position": 10,
   "since": "2010-02-26T20:06:24Z",
   "editor": "Punatähti",
   "rev_id": 900001918041
  },
  {
   "hash": "6f84a3c16c7f1140ef89cf5ba305251d8b16a20eef8551633fbcbb4ee25f3d4b",
   "text": "Nykyään tutkimuksessa käytetään yleisimmin neutraalia nimeä sisällissota.",
   "position": 11,
   "since": "2012-11-22T22:34:24Z",
   "editor": "Neutraali",
   "rev_id": 900001918045
  },
  {
   "hash": "66c01e0c14560c9272f005ebc7f8fa9774f020ed2534cb5c0847ef912cb3bf17",
   "text": "Vuoden 2018 muistovuonna sotaa käsiteltiin laajasti sovinnon hengessä.",
   "position": 12,
   "since": "2014-02-28T00:25:24Z",
   "editor": "Aino_K",
   "rev_id": 900001918048
  }
 ]
}