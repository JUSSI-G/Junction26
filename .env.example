# Copy to .env (read by common/db.py and dev.py). All values have these defaults.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=wiki
DATASET=demo             # demo | small | medium | large  (see docs/decisions.md)

# Scoring (P3). Any OpenAI-compatible endpoint: vLLM on Verda, Ollama, Featherless.
SCORING_URL=             # e.g. http://<verda-ip>:8000/v1
GEMMA_MODEL=             # e.g. google/gemma-3-12b-it
SCORING_API_KEY=         # only for hosted endpoints
HF_TOKEN=                # for downloading Gemma weights on Verda
